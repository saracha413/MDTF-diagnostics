// llj pod settings for MDTF-diagnostics packaged
// modify the pod_env_vars as needed
// 
{
	"settings": {
		"driver": "llj.py",
		"long_name": "Great Plains Low Level Jet Diagnostics",
		"convention": "cmip",
		"description": "Great Plains Low Level Jet Diagnostics",
		"runtime_requirements": {
			"python3": [
				"numpy",
				"scipy",
				"matplotlib",
				"xarray",
				"netCDF4",
				"cartopy",
				"pyllj",
				"xarray",
                "intake", 
                "yaml",
                "sys",
                "os",
                "datetime", 
                "netCDF4",
                "tqdm", 
                "cartopy", 
                "earthaccess",
                "cdsapi"
                ]
		},
	},
	"dimensions": {
		"lat": {
                 "standard_name": "North latitude array of grid",
                 "units": "degrees",
                 "axis": "Y"
               },
        "lon": {
                 "standard_name": "East longitude array of grid",
                 "units": "degrees",
                 "axis": "X"
                },
		"time": {
			      "standard_name": "time"
		        }
	},
	"varlist": {
	    "ucomp": {
			"standard_name": "zonal wind",
			"dimensions": ["time", "pfull", "grid_yt", "grid_xt"],
			"valid_range": [-330.0, 330.0],
			"units": "m/sec",
			"cell_methods" : "time: mean",
			"_FillValue": -1.e+10f,
            "missing_value": -1.e+10f, 
            "time_avg_info": ["average_T1",average_T2","average_DT"],
            "requirement": "required"

		},
		"vcomp": {
			"standard_name": "meridional wind",
			"dimensions": ["time", "pfull", "grid_yt", "grid_xt"],
			"valid_range": [-330.0, 330.0],
			"units": "m/sec",
			"cell_methods" : "time: mean",
			"_FillValue": -1.e+10f,
            "missing_value": -1.e+10f, 
            "time_avg_info": ["average_T1",average_T2","average_DT"],
            "requirement": "required"
		},
		"zg": {
			"standard_name": "geopotential_height",
            "long_name": "Geopotential Height",
			"units": "m",
			"dimensions": ["time", "levhalf", "lat", "lon"],
			"_FillValue": -1.e+20f,
            "missing_value": -1.e+20f, 
    		"cell_methods": "time: point",
    		"cell_measures": "area: area",
    		"interp_method": "conserve_order1",
			"requirement": "required"
		},
		"sphum": {
			"standard_name": "specific humidity",
            "dimensions": ["time", "pfull", "grid_yt", "grid_xt"],
			"_FillValue": -1.e+10f,
            "missing_value": -1.e+10f, 
            "units": "kg/kg",
            "cell_methods": "time: mean",
            "time_avg_info": ["average_T1",average_T2","average_DT"],
			"requirement": "required"
		},
		"ps": {
			"standard_name": "surface pressure",
            "dimensions": ["time", grid_yt", "grid_xt"],
			"_FillValue": -1.e+10f,
            "missing_value": -1.e+10f, 
            "units": "Pa", 
            "cell_methods": "time: mean", 
            "time_avg_info": ["average_T1",average_T2","average_DT"],
			"requirement": "required"
		}
	}
}
